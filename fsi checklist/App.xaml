<?xml version = "1.0" encoding = "UTF-8" ?>
<!--
    Ang App.xaml: dinhi gikarga ang mga kolor (Colors.xaml) ug estilo (Styles.xaml) nga gamiton sa tibuok app.
-->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:fsi_checklist"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="fsi_checklist.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <!-- UraniumUI StyleResource gi-off sa karon: mo-crash sa Windows (walay error sa app.log) -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
