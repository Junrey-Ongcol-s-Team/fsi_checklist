<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="fsi_checklist.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    Title="Settings">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="16">
                <material:TextField Title="Fire station name" Text="{Binding StationName}" />

                <material:TextField Title="Fire station address" Text="{Binding StationAddress}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="1"
            Margin="16,8,16,16"
            Command="{Binding SaveCommand}"
            CornerRadius="12"
            FontAttributes="Bold"
            HeightRequest="52"
            Text="Save" />
    </Grid>
</ContentPage>
