<?xml version="1.0" encoding="utf-8" ?>
<!--
    Settings page (ngalan ug address sa istasyon).
-->
<ContentPage
    x:Class="fsi_checklist.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label FontSize="12" Text="Fire station name" />
            <Entry Text="{Binding StationName}" />

            <Label FontSize="12" Text="Fire station address" />
            <Entry Text="{Binding StationAddress}" />

            <Button
                Margin="0,12,0,0"
                Command="{Binding SaveCommand}"
                CornerRadius="12"
                HeightRequest="52"
                Text="Save" />

            <!--  PRE-SIGNED NGA PIRMA: mo-pirma kausa ra ang taga-BFP; gamiton na kini kada inspection  -->
            <Label
                Margin="0,24,0,0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Saved signatures (BFP)" />
            <Label
                FontSize="12"
                Text="Sign once here. The app puts these signatures on every inspection. Only the owner / representative signs each inspection."
                TextColor="{AppThemeBinding Light=#616161, Dark=#B0B0B0}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Presigns}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label FontAttributes="Bold" Text="{Binding RoleLabel}" />
                                <Label FontSize="13" Text="{Binding NameText}" />
                                <GraphicsView
                                    Drawable="{Binding Preview}"
                                    HeightRequest="60"
                                    IsVisible="{Binding HasPreview}" />
                                <Button
                                    Clicked="OnPresignClicked"
                                    HeightRequest="44"
                                    Text="{Binding ButtonText}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!--  PARA SA DEBUGGING: asa ang database ug log, ug ang Reset  -->
            <Label
                Margin="0,24,0,0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Database" />
            <Label FontSize="12" Text="Database file" />
            <Entry IsReadOnly="True" Text="{Binding DatabasePath, Mode=OneWay}" />
            <Label FontSize="12" Text="Error log (open with Notepad)" />
            <Entry IsReadOnly="True" Text="{Binding LogPath, Mode=OneWay}" />
            <Button
                BackgroundColor="#C62828"
                Command="{Binding ResetDatabaseCommand}"
                Text="Reset database"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
