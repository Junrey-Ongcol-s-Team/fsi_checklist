<?xml version="1.0" encoding="utf-8" ?>
<!--
    Settings page (ngalan ug address sa istasyon).
-->
<ContentPage
    x:Class="fsi_checklist.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:fsi_checklist.Controls.Settings"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <!--  LETTERHEAD sa tanang printout (kaugalingong control: Controls/Settings/StationInfoField)  -->
            <Label FontAttributes="Bold" FontSize="18" Text="Fire station (letterhead)" />
            <Label
                FontSize="12"
                Text="Printed at the top of every form, in this order: Region, Provincial Office, Station, Address, Hotline/Email."
                TextColor="{AppThemeBinding Light=#616161, Dark=#B0B0B0}" />
            <settings:StationInfoField
                Example="Region 10"
                Text="{Binding StationRegion}"
                Title="1. Region" />
            <settings:StationInfoField
                Example="Misamis Occidental Provincial Office"
                Text="{Binding StationOffice}"
                Title="2. Provincial / District Office" />
            <settings:StationInfoField
                Example="Tangub City Fire Station"
                Text="{Binding StationName}"
                Title="3. Fire station name" />
            <settings:StationInfoField
                Example="1st South Street, Brgy III, Tangub City"
                Text="{Binding StationAddress}"
                Title="4. Fire station address" />
            <settings:StationInfoField
                Example="545-0500"
                Keyboard="Telephone"
                Text="{Binding StationHotline}"
                Title="5. Station hotline number" />
            <settings:StationInfoField
                Example="tangubcfs_bfp10@yahoo.com"
                Keyboard="Email"
                Text="{Binding StationEmail}"
                Title="5. Email (printed after the hotline: 545-0500/email)" />

            <settings:SaveSettingsButton Command="{Binding SaveCommand}" />

            <!--  PRE-SIGNED NGA PIRMA: mo-pirma kausa ra ang taga-BFP; gamiton na kini kada inspection  -->
            <Label
                Margin="0,24,0,0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Saved signatures (BFP)" />
            <Label
                FontSize="12"
                Text="Sign once here. The app puts these signatures on every inspection. Only the owner / representative signs each inspection."
                TextColor="{AppThemeBinding Light=#616161, Dark=#B0B0B0}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Presigns}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label FontAttributes="Bold" Text="{Binding RoleLabel}" />
                                <Label FontSize="13" Text="{Binding NameText}" />
                                <GraphicsView
                                    Drawable="{Binding Preview}"
                                    HeightRequest="60"
                                    IsVisible="{Binding HasPreview}" />
                                <settings:PresignButton Clicked="OnPresignClicked" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!--  PARA SA DEBUGGING: asa ang database ug log, ug ang Reset  -->
            <Label
                Margin="0,24,0,0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Database" />
            <Label FontSize="12" Text="Database file" />
            <settings:DatabasePathBox Text="{Binding DatabasePath, Mode=OneWay}" />
            <Label FontSize="12" Text="Error log (open with Notepad)" />
            <settings:ErrorLogPathBox Text="{Binding LogPath, Mode=OneWay}" />
            <settings:ResetDatabaseButton Command="{Binding ResetDatabaseCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
