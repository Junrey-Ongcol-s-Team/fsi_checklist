<?xml version="1.0" encoding="utf-8" ?>
<!--
    PHOTO VIEWER (para sa cellphone): ipakita ang usa ka litrato sa tibuok screen.
    - Pinch (duha ka tudlo) = zoom.  Drag (usa ka tudlo) = i-move kung naka-zoom.
    - Double-tap = zoom / balik sa normal.
    - Close o ang Back button sa phone = balik sa page nga gigikanan.
-->
<ContentPage
    x:Class="fsi_checklist.Views.PhotoViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Photo"
    BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <!--  IsClippedToBounds: ang na-zoom nga litrato dili mo-tabon sa Close button  -->
        <ContentView Grid.Row="0" IsClippedToBounds="True">
            <!--  AspectFit = makita ang tibuok litrato, dili ma-crop  -->
            <Image x:Name="Photo" Aspect="AspectFit">
                <Image.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
                </Image.GestureRecognizers>
            </Image>
        </ContentView>

        <!--  Dako nga button para sayon i-tap sa tudlo  -->
        <Button
            Grid.Row="1"
            Margin="16"
            HeightRequest="48"
            Clicked="OnCloseClicked"
            Text="Close" />
    </Grid>
</ContentPage>
