<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page sa dagkong button: usa ka button matag klase sa inspection.
-->
<ContentPage
    x:Class="fsi_checklist.Views.ChecklistTypesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:fsi_checklist.ViewModels"
    Title="Fire Safety Inspection">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,24"
            BindableLayout.ItemsSource="{Binding Tiles}"
            Spacing="14">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="22,0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        HeightRequest="84"
                        Opacity="{Binding TileOpacity}"
                        Stroke="{AppThemeBinding Light=#9E9E9E, Dark=#6E6E6E}"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1.5">
                        <Border.GestureRecognizers>
                            <!--  Code-behind handler (dili RelativeSource): ang RelativeSource mahimong null kung tangtangon ang page, ug mo-crash.  -->
                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnTileTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Title}" />
                            <Label
                                FontSize="12"
                                Text="{Binding Subtitle}"
                                TextColor="{AppThemeBinding Light=#616161, Dark=#B0B0B0}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
