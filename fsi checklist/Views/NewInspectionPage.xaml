<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page sa pagsulod sa detalye sa bag-ong inspection.
-->
<ContentPage
    x:Class="fsi_checklist.Views.NewInspectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:newinsp="clr-namespace:fsi_checklist.Controls.NewInspectionScreen"
    Title="New inspection">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                IsVisible="{Binding HasNoTemplates}"
                Text="No checklists are installed yet. Add a form seed script to make one available here." />

            <Label
                FontAttributes="Bold"
                FontSize="20"
                IsVisible="{Binding IsTemplateFixed}"
                Text="{Binding SelectedTemplate.DisplayName}" />

            <Label FontSize="12" IsVisible="{Binding ShowPicker}" Text="Checklist" />
            <newinsp:ChecklistPicker IsVisible="{Binding ShowPicker}"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding SelectedTemplate}" />

            <Label FontSize="12" Text="{Binding SubjectLabel}" />
            <newinsp:EstablishmentNameField Text="{Binding SubjectName}" />

            <Label FontSize="12" Text="Address" />
            <newinsp:EstablishmentAddressField Text="{Binding Address}" />

            <Label FontSize="12" Text="Owner / representative" />
            <newinsp:OwnerNameField Text="{Binding OwnerName}" />

            <!--  Contact number: numero ra, 11 ka numero (ang letra dili madawat)  -->
            <Label FontSize="12" Text="Contact number (11 digits)" />
            <newinsp:OwnerContactNumberField Text="{Binding ContactNo}" />

            <Label FontSize="12" Text="Inspection order / control no." />
            <newinsp:InspectionOrderNumberField Text="{Binding ReferenceNo}" />

            <Label FontSize="12" Text="Date inspected" />
            <newinsp:DateInspectedPicker Date="{Binding DateInspected}" />

            <newinsp:StartInspectionButton Command="{Binding CreateCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
