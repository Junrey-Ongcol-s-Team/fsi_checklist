<?xml version="1.0" encoding="utf-8" ?>
<!--
    PAGE 3 (Form): ang checklist. Sa ubos naay progress bar ug mga button: Save draft, Next missing, Sign-off.
-->
<ContentPage
    x:Class="fsi_checklist.Views.FormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:fsi_checklist.Views"
    Title="{Binding Title}">

    <ContentPage.Resources>

        <Style x:Key="ChoiceChip" TargetType="Button">
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#BDBDBD, Dark=#5A5A5A}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#424242, Dark=#E0E0E0}" />
        </Style>

        <!--  Section header  -->
        <DataTemplate x:Key="SectionTemplate">
            <Label
                Margin="0,14,0,2"
                FontAttributes="Bold"
                FontSize="18"
                IsVisible="{Binding IsVisible}"
                Text="{Binding Title}" />
        </DataTemplate>

        <!--  Answer slots  -->
        <DataTemplate x:Key="TextSlot">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasLabel}"
                    Text="{Binding Label}" />
                <Entry Placeholder="{Binding Hint}" Text="{Binding Text}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="LongTextSlot">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasLabel}"
                    Text="{Binding Label}" />
                <Editor
                    AutoSize="TextChanges"
                    MinimumHeightRequest="80"
                    Text="{Binding Text}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="NumberSlot">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasLabel}"
                    Text="{Binding Label}" />
                <Entry
                    Keyboard="Numeric"
                    Placeholder="{Binding Hint}"
                    Text="{Binding Text}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="DateSlot">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasLabel}"
                    Text="{Binding Label}" />
                <HorizontalStackLayout Spacing="8">
                    <DatePicker Date="{Binding DateValue}" IsVisible="{Binding HasDate}" />
                    <Button
                        Command="{Binding SetTodayCommand}"
                        IsVisible="{Binding HasNoDate}"
                        Text="Set date" />
                    <Button
                        Command="{Binding ClearDateCommand}"
                        IsVisible="{Binding HasDate}"
                        Text="Clear" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="BoolSlot">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasLabel}"
                    Text="{Binding Label}" />
                <CheckBox HorizontalOptions="Start" IsChecked="{Binding IsChecked}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceSlot">
            <VerticalStackLayout Spacing="4">
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasLabel}"
                    Text="{Binding Label}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Options}" Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,8,8"
                                Command="{Binding SelectCommand}"
                                Style="{StaticResource ChoiceChip}"
                                Text="{Binding Label}">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Button"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="PhotoSlot">
            <Label
                FontAttributes="Italic"
                FontSize="13"
                Text="{Binding Hint}" />
        </DataTemplate>

        <views:SlotTemplateSelector
            x:Key="SlotSelector"
            BoolTemplate="{StaticResource BoolSlot}"
            ChoiceTemplate="{StaticResource ChoiceSlot}"
            DateTemplate="{StaticResource DateSlot}"
            LongTextTemplate="{StaticResource LongTextSlot}"
            NumberTemplate="{StaticResource NumberSlot}"
            PhotoTemplate="{StaticResource PhotoSlot}"
            TextTemplate="{StaticResource TextSlot}" />

        <!--  Item card  -->
        <DataTemplate x:Key="ItemTemplate">
            <Border
                Margin="{Binding Margin}"
                Padding="12"
                BackgroundColor="{AppThemeBinding Light=White,
                                                  Dark=#1E1E1E}"
                IsVisible="{Binding IsVisible}"
                Stroke="{AppThemeBinding Light=#E0E0E0,
                                         Dark=#3C3C3C}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <!--  Yellow nga frame kung kulang ang tubag (human mo-tap og Next missing)  -->
                <Border.Triggers>
                    <DataTrigger
                        Binding="{Binding IsMissing}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="Stroke" Value="#F9A825" />
                        <Setter Property="StrokeThickness" Value="3" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label FontSize="15" Text="{Binding LabelText}" />
                    <Label
                        FontSize="12"
                        IsVisible="{Binding HasHelp}"
                        Text="{Binding HelpText}" />
                    <VerticalStackLayout
                        BindableLayout.ItemTemplateSelector="{StaticResource SlotSelector}"
                        BindableLayout.ItemsSource="{Binding Slots}"
                        Spacing="8" />

                    <!--  LITRATO: makita ra kung kinahanglan og litrato ang pangutana (064 photos, Defects)  -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding PhotoSlots}"
                        IsVisible="{Binding HasPhotoSlots}"
                        Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="6">
                                    <Label FontAttributes="Bold" FontSize="13" Text="{Binding Label}" />

                                    <!--  Take photo = camera, Choose photo = gallery / file  -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Clicked="OnTakePhotoClicked" FontSize="13" Text="Take photo" />
                                        <Button Clicked="OnChoosePhotoClicked" FontSize="13" Text="Choose photo" />
                                    </HorizontalStackLayout>

                                    <!--  Ang gagmay nga hulagway, uban ang Remove  -->
                                    <FlexLayout BindableLayout.ItemsSource="{Binding Photos}" Wrap="Wrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout Margin="0,0,8,8" Spacing="4">
                                                    <!--  I-tap ang litrato para makita og dako  -->
                                                    <Image
                                                        Aspect="AspectFill"
                                                        HeightRequest="96"
                                                        Source="{Binding FullPath}"
                                                        WidthRequest="96">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnPhotoTapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                    <Button
                                                        Clicked="OnRemovePhotoClicked"
                                                        FontSize="12"
                                                        HeightRequest="32"
                                                        Padding="8,0"
                                                        Text="Remove" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <views:FormRowTemplateSelector
            x:Key="RowSelector"
            ItemTemplate="{StaticResource ItemTemplate}"
            SectionTemplate="{StaticResource SectionTemplate}" />

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Label
            Grid.Row="0"
            Padding="16,8"
            FontAttributes="Bold"
            Text="{Binding Subtitle}" />

        <!--  ANG MGA PANGUTANA (gihimo gikan sa database)  -->
        <ScrollView x:Name="FormScroll" Grid.Row="1">
            <VerticalStackLayout
                x:Name="RowsLayout"
                Padding="12,0,12,24"
                BindableLayout.ItemTemplateSelector="{StaticResource RowSelector}"
                BindableLayout.ItemsSource="{Binding Rows}"
                Spacing="10" />
        </ScrollView>

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />

        <Border
            Grid.Row="2"
            Padding="12,8"
            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding ProgressText}" />
                    <Label
                        Grid.Column="1"
                        FontSize="12"
                        Text="{Binding SaveStatus}" />
                </Grid>
                <ProgressBar Progress="{Binding ProgressFraction}" ProgressColor="{Binding ProgressColor}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <!--  Save draft = mobalik sa dashboard; Next missing = pangitaon ang kulang; Sign-off = pirma  -->
                    <Button
                        Command="{Binding SaveDraftCommand}"
                        FontSize="13"
                        Text="Save draft" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding NextMissingCommand}"
                        FontSize="13"
                        Text="Next missing" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding GoToSignoffCommand}"
                        FontSize="13"
                        Text="Sign-off" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
