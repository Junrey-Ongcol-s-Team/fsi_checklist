<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Ang AppShell: ang 'kuwadro' sa navigation. Ang unang page nga makita kay MainPage.
-->
<Shell
    x:Class="fsi_checklist.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:fsi_checklist"
    Title="BFP Fire System Checklist Inspection">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
