<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="fsi_checklist.Views.NewInspectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="New inspection">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                IsVisible="{Binding HasNoTemplates}"
                Text="No checklists are installed yet. Add a form seed script to make one available here." />

            <Label FontSize="12" Text="Checklist" />
            <Picker
                Title="Choose a checklist"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding SelectedTemplate}" />

            <Label FontSize="12" Text="{Binding SubjectLabel}" />
            <Entry Text="{Binding SubjectName}" />

            <Label FontSize="12" Text="Address" />
            <Entry Text="{Binding Address}" />

            <Label FontSize="12" Text="Owner / representative" />
            <Entry Text="{Binding OwnerName}" />

            <Label FontSize="12" Text="Contact number" />
            <Entry Keyboard="Telephone" Text="{Binding ContactNo}" />

            <Label FontSize="12" Text="Inspection order / control no." />
            <Entry Text="{Binding ReferenceNo}" />

            <Label FontSize="12" Text="Date inspected" />
            <DatePicker Date="{Binding DateInspected}" />

            <Button
                Margin="0,12,0,0"
                Command="{Binding CreateCommand}"
                CornerRadius="12"
                FontAttributes="Bold"
                HeightRequest="52"
                Text="Start inspection" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
